<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>SysValley.Danfse</RootNamespace>
    <AssemblyName>SysValley.Danfse</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Company>SysValley</Company>
    <Product>DANFSe v2.0</Product>
    <Description>Geracao do DANFSe v2.0 (Documento Auxiliar da NFS-e Nacional) em PDF a partir do XML da NFS-e.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="1.50.5147" />
    <PackageReference Include="QRCoder" Version="1.4.3" />
  </ItemGroup>

</Project>
